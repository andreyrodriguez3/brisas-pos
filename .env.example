# ─────────────────────────────────────────────────────────────
# Brisas POS — copiá este archivo a .env y ajustá los valores.
# El .env vive SOLO en la PC de caja. No se versiona.
# ─────────────────────────────────────────────────────────────

# Base de datos SQLite. Ruta relativa a packages/backend/prisma/.
# En producción usá una ruta absoluta fuera del escritorio, ej:
#   DATABASE_URL="file:C:/BrisasPOS/data/brisas.sqlite"
DATABASE_URL="file:../data/brisas.sqlite"

# Puerto del backend. Los celulares y la tablet entran a http://<IP-DE-CAJA>:3000
PORT=3000

# CRÍTICO: 0.0.0.0 hace que el servidor sea visible desde la red WiFi.
# Con 127.0.0.1 solo lo ve la propia PC de caja y NINGÚN celular puede conectarse.
HOST=0.0.0.0

# Secreto para firmar los JWT. NO lo escribas a mano: generalo con
#   npm run secreto:escribir
# Quien tenga este valor puede fabricarse un token de administradora desde
# cualquier celular del WiFi, sin saber ningún PIN. Con NODE_ENV=production el
# servidor SE NIEGA A ARRANCAR si quedó este valor de ejemplo o si es corto.
JWT_SECRET="cambiar-esto-por-una-cadena-larga-y-aleatoria"

# Vida de la sesión. La mesera no debe loguearse cada rato; caja sí es más corta.
JWT_EXPIRES_MESERA="30d"
JWT_EXPIRES_CAJA="12h"

# Intentos de PIN fallidos antes de bloquear temporalmente al usuario.
MAX_INTENTOS_PIN=5
BLOQUEO_PIN_MINUTOS=5

# Orígenes permitidos por CORS. "lan" abre a cualquier IP privada de la red local.
CORS_ORIGENES="lan"

NODE_ENV=development
